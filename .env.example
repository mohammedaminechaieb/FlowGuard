# Settings for scripts run on your PC. Nothing loads this file automatically:
# set them as environment variables if you need other values than the defaults.
# docker-compose.yml sets the in-container values itself (kafka:29092, cassandra).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=network-telemetry
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=flowguard
DATA_DIR=data
ARTIFACTS_DIR=ai_module/artifacts
MODEL_DIR=ai_module/artifacts